# ═════════════════════════════════════════════════════════════════════════════
# PET PRODUCTION ENVIRONMENT — office PC behind a Cloudflare Tunnel
# (Option 2 in docs/PET/13_OFFICE_PC_CLOUDFLARE_TUNNEL_GOLIVE.md)
#
#   Windows : copy to  C:\PET\app\.env.production      (next to package.json)
#   Linux   : copy to  /opt/PET/.env.production
#
# `npm start` / the installed service loads this file automatically.
# NEVER commit the real file: .gitignore excludes every `.env*` except the
# `.example` templates. The Trust owns this file and its secrets.
#
# Generate the secrets (run once, on the server machine):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ═════════════════════════════════════════════════════════════════════════════

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production

# Bind to loopback only: cloudflared runs on this same PC and is the single
# way in. Nothing is exposed to the office LAN or the internet directly.
# (Want staff on the office Wi-Fi to reach it directly too? HOST=0.0.0.0 and
#  allow TCP 8080 from the local subnet only, in Windows Firewall.)
HOST=127.0.0.1
PORT=8080

# The public URL employees will open. Must be https and must not be localhost.
# This is the Cloudflare Tunnel hostname you routed to this machine.
PUBLIC_BASE_URL=https://app.YOURDOMAIN.org

# ── Hosted static app (Vercel) ──────────────────────────────────────────────
# Build-time variable FOR THE VERCEL PROJECT (not this server): the public URL
# of THIS server, so the hosted app knows where its data is.
#   Vercel → project → Settings → Environment Variables → PET_API_BASE
#   PET_API_BASE=https://app.YOURDOMAIN.org
# Leave it unset and the hosted app is an honest interface preview that cannot
# sign anyone in. Add the deployment origin to CORS_ORIGINS below either way.


# Behind Cloudflare: the tunnel terminates TLS at Cloudflare's edge.
TRUST_PROXY=1

# ── Secrets (generate fresh ones; never reuse the examples) ─────────────────
# Signs control-plane tokens + admin CSRF tokens. ≥32 chars.
LICENSE_TOKEN_SECRET=REPLACE_WITH_64_RANDOM_CHARS
# Signs employee / Main Admin access JWTs. ≥32 chars, different from the above.
PET_JWT_SECRET=REPLACE_WITH_64_DIFFERENT_RANDOM_CHARS
# One-time guard for creating the first Main Admin (server/scripts/pet-bootstrap.js).
# Used once at go-live; keep it set and secret.
PET_BOOTSTRAP_SECRET=REPLACE_WITH_RANDOM_VALUE

# ── Data (Trust-owned; back this up) ────────────────────────────────────────
# Windows:
DATABASE_PATH=C:\PET\data\control-plane.db
PET_DATABASE_PATH=C:\PET\data\pet.db
PET_UPLOAD_DIR=C:\PET\data\uploads
PET_BACKUP_DIR=C:\PET\data\backups
# Linux:
# DATABASE_PATH=/var/lib/pet/control-plane.db
# PET_DATABASE_PATH=/var/lib/pet/pet.db
# PET_UPLOAD_DIR=/var/lib/pet/uploads
# PET_BACKUP_DIR=/var/lib/pet/backups

# ── Cross-origin ────────────────────────────────────────────────────────────
# The web app and the API are served from the SAME origin (one URL), so no
# CORS allowlist is needed. Leave empty — an empty list is the strictest
# setting: no cross-origin caller is allowed at all.
# Only fill this in if a future client (e.g. the Android wrapper on a separate
# host) must call the API from another origin. Exact origins, never a wildcard.
# Exact origins allowed to call this API from a browser (no wildcards).
# REQUIRED for the hosted static build (Vercel) to work: without the deployment
# origin here, sign-in from that URL fails with an opaque network error.
#   CORS_ORIGINS=https://pet-app.vercel.app
# Check both ends with:  npm run verify:deploy -- --url https://pet-app.vercel.app
CORS_ORIGINS=

# ── Backups / retention (defaults are fine) ─────────────────────────────────
PET_BACKUP_KEEP_DAILY=14
PET_BACKUP_KEEP_WEEKLY=8
PET_BACKUP_KEEP_MONTHLY=3

# ── Attendance policy ───────────────────────────────────────────────────────
PET_WORK_START_TIME=10:00
PET_WORK_START_GRACE_MINUTES=15

# ── Build safety (do not change unless recovering an emergency) ─────────────
# The server refuses to start in production when the web bundle does not match
# the checked-out source — that is what prevents "still showing the old build".
# PET_ALLOW_STALE_BUILD=1 downgrades that to a warning. Use it only to get a
# broken machine back online, then remove it.
# PET_ALLOW_STALE_BUILD=0
