{
  "name": "school-management-system",
  "private": true,
  "version": "1.0.0",
  "description": "Commercial School Management System — desktop app + production control plane",
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "dev:admin": "vite --config vite.admin.config.ts --port=3001 --host=0.0.0.0",
    "build:admin": "vite build --config vite.admin.config.ts",
    "dev:pet": "vite --config vite.pet.config.ts --port=3002 --host=0.0.0.0",
    "build:pet": "vite build --config vite.pet.config.ts",
    "server:dev": "node server/src/index.js",
    "server:start": "node server/src/index.js",
    "server:bootstrap": "node server/scripts/bootstrap.js",
    "server:backup": "node server/scripts/backup.js",
    "pet:bootstrap": "node server/scripts/pet-bootstrap.js",
    "pet:backup": "node server/scripts/pet-backup.js",
    "pet:backup:weekly": "node server/scripts/pet-backup.js --weekly",
    "pet:backup:monthly": "node server/scripts/pet-backup.js --monthly",
    "server:test": "node --test \"server/test/*.test.js\"",
    "desktop": "electron .",
    "desktop:build": "vite build && npx electron-builder",
    "desktop:win": "npm run dist:win",
    "desktop:mac": "vite build && npx electron-builder --mac",
    "desktop:linux": "vite build && npx electron-builder --linux",
    "dist:win": "node scripts/write-build-config.mjs && npm run build && npm run build:admin && npx electron-builder --win",
    "dist:linux": "node scripts/write-build-config.mjs && npm run build && npm run build:admin && npx electron-builder --linux",
    "audit:prod": "node scripts/audit-prod.mjs",
    "release:check": "node scripts/release-check.mjs",
    "android:init": "node scripts/write-build-config.mjs && npm run build && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "node scripts/write-build-config.mjs && npm run build && npx cap sync android && cd android && gradlew assembleRelease && copy app\\build\\outputs\\apk\\release\\app-release.apk ..\\SchoolManagement-Android.apk",
    "android:apk:bash": "node scripts/write-build-config.mjs && npm run build && npx cap sync android && cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../SchoolManagement-Android.apk",
    "android:open": "npx cap open android",
    "test:all": "npm run lint && npm run server:test",
    "clean": "rm -rf dist release server/public/admin",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "firebase": "^12.18.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.schoolmanagementsystem.desktop",
    "productName": "School Management System",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron.cjs",
      "electron/**/*",
      "assets/icon.png",
      "package.json",
      "!node_modules/better-sqlite3/**",
      "!node_modules/node-addon-api/**",
      "!server/**",
      "!admin/**",
      "!src/**",
      "!scripts/**",
      "!.env*",
      "!*.md",
      "!android/**",
      "!node_modules/better-sqlite3/**"
    ],
    "asar": true,
    "asarUnpack": [
      "assets/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "artifactName": "SchoolManagementSetup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "School Management System",
      "include": "installer.nsh"
    },
    "publish": []
  }
}
