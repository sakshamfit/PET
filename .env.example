# ═════════════════════════════════════════════════════════════════════════════
# SCHOOL MANAGEMENT SYSTEM — environment template
#
# Copy to the appropriate untracked file (NEVER commit real values):
#   server/.env  → loaded by your process manager (systemd/PM2), NOT by the app
#   shell exports for desktop builds (SMS_API_URL …)
#
# SECRET HYGIENE: values below are placeholders. Real secrets live ONLY in
# the deployment environment. Never put them in source, /public, renderer
# bundles, or the installer.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Control-plane server (production) ──────────────────────────────────────

# REQUIRED. Signs access tokens + admin CSRF tokens. ≥32 random chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LICENSE_TOKEN_SECRET="CHANGE_ME_48_CHARACTERS_MINIMUM_RANDOM"

# REQUIRED for the first production bootstrap (node server/scripts/bootstrap.js).
# Afterwards it must stay set to allow additional admin creation.
ADMIN_BOOTSTRAP_SECRET="CHANGE_ME_RANDOM_BOOTSTRAP_GUARD"

# REQUIRED in production. Absolute path of the control-plane SQLite database.
DATABASE_PATH="/var/lib/sms-control-plane/control-plane.db"

# REQUIRED in production. Public https URL of this API (used for health
# surfacing and production assertions). Never localhost in production.
PUBLIC_BASE_URL="https://api.example.com"

# HTTPS termination — choose ONE strategy:
#   A) Direct TLS by this process:
TLS_CERT_FILE="/etc/letsencrypt/live/api.example.com/fullchain.pem"
TLS_KEY_FILE="/etc/letsencrypt/live/api.example.com/privkey.pem"
#   B) Behind a TLS-terminating reverse proxy (nginx/caddy) instead:
# TRUST_PROXY="1"

# Exact browser origins allowed to call the API (comma-separated).
# The desktop app is not a browser and does not need CORS.
CORS_ORIGINS="https://admin.example.com"
# Origins allowed to call this API from a browser. One per line/entry, exact
# origins only (no wildcards). Add the hosted PET app so staff can sign in from
# a phone: CORS_ORIGINS="https://admin.example.com,https://pet-app.vercel.app"

# Server listen address
HOST="0.0.0.0"
PORT="8080"

# Token/session policy
ACCESS_TOKEN_TTL_SECONDS="900"      # 15 minutes
REFRESH_TOKEN_TTL_DAYS="30"
ADMIN_SESSION_HOURS="12"

# Licensing policy
OFFLINE_GRACE_HOURS="72"            # offline operation window after last verification
LICENSE_EXPIRING_SOON_DAYS="30"     # dashboard "expiring soon" window

# Server-side database backups (this is the LICENSE SERVER backup only —
# schools back up their own data to their own Google Drive).
BACKUP_DIR="/var/backups/sms-control-plane"
BACKUP_KEEP="14"

# For systemd: working directory + environment file
# NODE_ENV=production is set by the service manager.

# ─── Desktop build (at packaging time, on the build machine) ────────────────

# Injected into the installer by scripts/write-build-config.mjs.
SMS_API_URL="https://api.example.com"
SMS_UPDATE_CHANNEL="stable"
SMS_SUPPORT_CONTACT="support@example.com"

# Windows code signing (see CONTROL_PLANE.md §Code signing). Configure when
# the certificate exists — do not claim signing without it.
# CSC_LINK="C:\\certs\\codesigning.pfx"          (or EV token via eSigner/etc.)
# CSC_KEY_PASSWORD="…set only in CI secret store…"
# WIN_CSC_LINK / WIN_CSC_KEY_PASSWORD for electron-builder

# ─── Firebase web app (existing school portal) ───────────────────────────────
# Firebase web config is NOT secret by design and already ships in
# firebase-applet-config.json. There is intentionally nothing to add here.
# Gemini API keys are managed at runtime by the hosting platform, not here.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
