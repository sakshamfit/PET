{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@pet/*": ["./pet-web/src/*"]
    }
  },
  "include": ["pet-web/src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
